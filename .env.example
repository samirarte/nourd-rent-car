# ─── Turso (base de datos SQLite en el edge) ─────────────────────────────────
#
# Opciones para TURSO_DATABASE_URL:
#   - Base de datos remota Turso:  libsql://nombre-base.turso.io
#   - Archivo SQLite local:        file:./local.db  (solo para desarrollo)
#
TURSO_DATABASE_URL=libsql://nombre-base.turso.io
TURSO_AUTH_TOKEN=tu-token-de-autenticacion

# ─── WhatsApp ─────────────────────────────────────────────────────────────────
#
# Número de WhatsApp del negocio en formato internacional sin el símbolo '+'.
# Ejemplo para Marruecos (+212): 212600000000
#
PUBLIC_WHATSAPP_NUMBER=212600000000

# ─── Administración ───────────────────────────────────────────────────────────
# Contraseña para acceder al panel /admin (cámbiala en producción)
ADMIN_PASSWORD=cambia_esta_clave_en_produccion

# ─── Cloudflare (despliegue con Wrangler) ────────────────────────────────────
#
# Necesarias para ejecutar `npm run deploy` desde CI/CD o terminal local.
# Obtén estos valores en: https://dash.cloudflare.com/profile/api-tokens
#
# CLOUDFLARE_API_TOKEN  → Token de API con permiso "Cloudflare Pages: Edit"
# CLOUDFLARE_ACCOUNT_ID → ID de tu cuenta (aparece en la URL del dashboard)
#
CLOUDFLARE_API_TOKEN=tu-api-token-de-cloudflare
CLOUDFLARE_ACCOUNT_ID=tu-account-id-de-cloudflare

# ─── Versión de Node.js (Cloudflare Pages build settings) ────────────────────
#
# Cloudflare Pages usa esta variable para seleccionar la versión de Node.
# Valor recomendado: 20 (LTS)
#
NODE_VERSION=20
