---
/**
 * Footer — Pie de página de Nourd Rent Car. Soporta ES/EN.
 */
import { useTranslations, getNavLinks } from '../../i18n/utils';
import type { Lang } from '../../i18n/translations';

interface Props {
  lang?: Lang;
}

const { lang = 'es' }  = Astro.props;
const t                = useTranslations(lang);
const anioActual       = new Date().getFullYear();
const numeroWhatsApp   = import.meta.env.PUBLIC_WHATSAPP_NUMBER ?? '34600000000';
const enlaceWhatsApp   = `https://wa.me/${numeroWhatsApp}`;
const enlacesNav       = getNavLinks(lang);
---

<footer class="bg-[var(--color-primary-light)] border-t border-white/10 mt-auto">
  <div class="section-container py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10">

      <!-- Columna 1: Marca -->
      <div class="space-y-4">
        <a href={lang === 'en' ? '/en' : '/'} aria-label="Nourd Rent Car Casablanca — Inicio">
          <img src="/logo.svg" alt="Nourd Rent Car Casablanca" class="h-12 w-auto" />
        </a>
        <p class="text-[var(--color-text-muted)] text-sm leading-relaxed">
          {t('footer.tagline')}
        </p>
      </div>

      <!-- Columna 2: Navegación -->
      <div>
        <h3 class="text-white font-semibold mb-4 text-sm uppercase tracking-widest">
          {t('footer.nav')}
        </h3>
        <ul class="space-y-2">
          {enlacesNav.map(({ href, key }) => (
            <li>
              <a href={href}
                 class="text-[var(--color-text-muted)] text-sm hover:text-[var(--color-accent)]
                        transition-colors duration-200">
                {t(key as any)}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Columna 3: Contacto -->
      <div>
        <h3 class="text-white font-semibold mb-4 text-sm uppercase tracking-widest">
          {t('footer.contact')}
        </h3>
        <div class="space-y-3">
          <a href={enlaceWhatsApp} target="_blank" rel="noopener noreferrer"
             class="flex items-center gap-2 text-[var(--color-text-muted)] text-sm
                    hover:text-[var(--color-success)] transition-colors duration-200"
             aria-label="WhatsApp">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"
                 class="w-4 h-4 text-[var(--color-success)] shrink-0" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
              <path d="M12 0C5.373 0 0 5.373 0 12c0 2.124.554 4.118 1.523 5.847L.057 23.882a.75.75 0 0 0 .921.921l6.035-1.466A11.945 11.945 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 0 1-5.006-1.373l-.359-.214-3.723.904.92-3.619-.234-.372A9.818 9.818 0 1 1 12 21.818z"/>
            </svg>
            WhatsApp
          </a>
          <a href="mailto:info@nourdrentcar.com"
             class="flex items-center gap-2 text-[var(--color-text-muted)] text-sm
                    hover:text-[var(--color-accent)] transition-colors duration-200"
             aria-label="Email">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" class="w-4 h-4 shrink-0" aria-hidden="true">
              <rect width="20" height="16" x="2" y="4" rx="2"/>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
            info@nourdrentcar.com
          </a>
        </div>
      </div>
    </div>

    <div class="mt-10 pt-6 border-t border-white/10 flex flex-col sm:flex-row
                items-center justify-between gap-3 text-xs text-[var(--color-text-muted)]">
      <p>© {anioActual} Nourd Rent Car. {t('footer.rights')}</p>
      <p>{t('footer.location')}</p>
    </div>
  </div>
</footer>
