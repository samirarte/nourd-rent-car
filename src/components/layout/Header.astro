---
/**
 * Header — Cabecera principal de Nourd Rent Car.
 * Soporta selector de idioma ES/EN y enlace al panel de administración.
 */
import { useTranslations, getNavLinks, getAllAlternates, isRTL } from '../../i18n/utils';
import { LANGUAGES, type Lang } from '../../i18n/translations';

interface Props { lang?: Lang; }
const { lang = 'es' } = Astro.props;
const t          = useTranslations(lang);
const enlaces    = getNavLinks(lang);
const rutaActual = Astro.url.pathname;
const alternates = getAllAlternates(Astro.url);
const rtl        = isRTL(lang);
const currentLang = LANGUAGES.find(l => l.code === lang)!;
---

<header
  id="header-principal"
  class="sticky top-0 z-40 w-full transition-all duration-300
         bg-[var(--color-primary)]/80 backdrop-blur-md border-b border-white/5"
>
  <div class="section-container flex items-center justify-between h-16 md:h-20 gap-4">

    <!-- Logo -->
    <a href={lang === 'en' ? '/en' : '/'} class="shrink-0" aria-label="Nourd Rent Car Casablanca — Inicio">
      <img src="/logo.svg" alt="Nourd Rent Car Casablanca" class="h-10 md:h-12 w-auto" />
    </a>

    <!-- Navegación escritorio -->
    <nav aria-label={lang === 'en' ? 'Main navigation' : 'Navegación principal'}
         class="hidden md:flex items-center gap-6 lg:gap-8">
      {enlaces.map(({ href, key }) => {
        const activo = rutaActual === href || (href !== '/' && href !== '/en' && rutaActual.startsWith(href));
        return (
          <a
            href={href}
            class={`text-sm font-medium tracking-wide transition-colors duration-200
                    hover:text-[var(--color-accent)]
                    ${activo ? 'text-[var(--color-accent)]' : 'text-[var(--color-text-base)]'}`}
            aria-current={activo ? 'page' : undefined}
          >
            {t(key as any)}
          </a>
        );
      })}
    </nav>

    <!-- Acciones escritorio: selector idioma + admin -->
    <div class="hidden md:flex items-center gap-3">
      <!-- Selector de idioma (dropdown) -->
      <div class="relative" id="lang-menu-wrap">
        <button
          id="btn-lang"
          aria-haspopup="listbox"
          aria-expanded="false"
          aria-label="Cambiar idioma"
          class="flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-white/15
                 text-xs font-semibold text-[var(--color-text-muted)] hover:border-[var(--color-accent)]
                 hover:text-[var(--color-accent)] transition-all duration-200"
        >
          <span aria-hidden="true">{currentLang.flag}</span>
          <span>{currentLang.label}</span>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="w-3 h-3 opacity-60" aria-hidden="true">
            <path fill-rule="evenodd" d="M4.22 6.22a.75.75 0 0 1 1.06 0L8 8.94l2.72-2.72a.75.75 0 1 1 1.06 1.06l-3.25 3.25a.75.75 0 0 1-1.06 0L4.22 7.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"/>
          </svg>
        </button>
        <ul
          id="lang-dropdown"
          role="listbox"
          aria-label="Idiomas disponibles"
          class="hidden absolute right-0 top-full mt-1 w-32 rounded-xl border border-white/10
                 bg-[var(--color-primary-light)] shadow-xl z-50 overflow-hidden py-1"
        >
          {alternates.map(({ lang: code, label, flag, href }) => (
            <li role="option" aria-selected={code === lang}>
              <a href={href}
                 class={`flex items-center gap-2 px-3 py-2 text-xs font-semibold transition-colors duration-150
                         hover:bg-white/5 hover:text-[var(--color-accent)]
                         ${code === lang ? 'text-[var(--color-accent)]' : 'text-[var(--color-text-muted)]'}`}>
                <span aria-hidden="true">{flag}</span>
                <span>{label}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Acceso al panel de administración -->
      <a href="/admin"
         class="flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-white/15
                text-xs font-semibold text-[var(--color-text-muted)] hover:border-[var(--color-accent)]
                hover:text-[var(--color-accent)] transition-all duration-200"
         aria-label={t('nav.admin')}>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-3.5 h-3.5" aria-hidden="true">
          <path fill-rule="evenodd" d="M8.34 1.804A1 1 0 0 1 9.32 1h1.36a1 1 0 0 1 .98.804l.295 1.473c.497.144.971.342 1.416.587l1.25-.834a1 1 0 0 1 1.262.125l.962.962a1 1 0 0 1 .125 1.262l-.834 1.25c.245.445.443.919.587 1.416l1.473.294a1 1 0 0 1 .804.98v1.361a1 1 0 0 1-.804.98l-1.473.295a6.95 6.95 0 0 1-.587 1.416l.834 1.25a1 1 0 0 1-.125 1.262l-.962.962a1 1 0 0 1-1.262.125l-1.25-.834a6.953 6.953 0 0 1-1.416.587l-.294 1.473a1 1 0 0 1-.98.804H9.32a1 1 0 0 1-.98-.804l-.295-1.473a6.957 6.957 0 0 1-1.416-.587l-1.25.834a1 1 0 0 1-1.262-.125l-.962-.962a1 1 0 0 1-.125-1.262l.834-1.25a6.957 6.957 0 0 1-.587-1.416l-1.473-.294A1 1 0 0 1 1 10.68V9.32a1 1 0 0 1 .804-.98l1.473-.295c.144-.497.342-.971.587-1.416l-.834-1.25a1 1 0 0 1 .125-1.262l.962-.962A1 1 0 0 1 5.38 2.03l1.25.834a6.957 6.957 0 0 1 1.416-.587L8.34 1.804ZM10 13a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" clip-rule="evenodd"/>
        </svg>
        Admin
      </a>
    </div>

    <!-- Botón hamburguesa (móvil) -->
    <button
      id="btn-menu"
      aria-label={lang === 'en' ? 'Open navigation menu' : 'Abrir menú de navegación'}
      aria-expanded="false"
      aria-controls="menu-movil"
      class="md:hidden flex flex-col justify-center items-center w-10 h-10 gap-1.5
             rounded-lg hover:bg-white/10 transition-colors duration-200 ml-auto"
    >
      <span class="hamburger-line block w-6 h-0.5 bg-white transition-all duration-300"></span>
      <span class="hamburger-line block w-6 h-0.5 bg-white transition-all duration-300"></span>
      <span class="hamburger-line block w-6 h-0.5 bg-white transition-all duration-300"></span>
    </button>
  </div>

  <!-- Menú móvil desplegable -->
  <nav
    id="menu-movil"
    aria-label={lang === 'en' ? 'Mobile menu' : 'Menú móvil'}
    class="md:hidden hidden flex-col border-t border-white/10 bg-[var(--color-primary-light)]"
  >
    {enlaces.map(({ href, key }) => {
      const activo = rutaActual === href || (href !== '/' && href !== '/en' && rutaActual.startsWith(href));
      return (
        <a
          href={href}
          class={`px-6 py-4 text-base font-medium border-b border-white/5
                  transition-colors duration-200 hover:bg-white/5 hover:text-[var(--color-accent)]
                  ${activo ? 'text-[var(--color-accent)]' : 'text-[var(--color-text-base)]'}`}
          aria-current={activo ? 'page' : undefined}
        >
          {t(key as any)}
        </a>
      );
    })}

    <!-- Selector idioma + Admin en móvil -->
    <div class="flex items-center gap-3 px-6 py-4 border-b border-white/5 flex-wrap">
      {alternates.map(({ lang: code, label, flag, href }) => (
        <a href={href}
           class={`flex items-center gap-1.5 px-3 py-1.5 rounded-full border text-xs font-semibold
                   transition-all duration-200
                   ${code === lang
                     ? 'border-[var(--color-accent)] text-[var(--color-accent)]'
                     : 'border-white/15 text-[var(--color-text-muted)] hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]'}`}>
          <span aria-hidden="true">{flag}</span>
          <span>{label}</span>
        </a>
      ))}
      <a href="/admin"
         class="flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-white/15
                text-xs font-semibold text-[var(--color-text-muted)] hover:border-[var(--color-accent)]
                hover:text-[var(--color-accent)] transition-all duration-200">
        Admin
      </a>
    </div>
  </nav>
</header>

<script>
  const btnMenu   = document.getElementById('btn-menu');
  const menuMovil = document.getElementById('menu-movil');
  const lineas    = document.querySelectorAll<HTMLElement>('.hamburger-line');

  btnMenu?.addEventListener('click', () => {
    const abierto = btnMenu.getAttribute('aria-expanded') === 'true';
    btnMenu.setAttribute('aria-expanded', String(!abierto));
    if (abierto) {
      menuMovil?.classList.add('hidden');
      menuMovil?.classList.remove('flex');
      lineas[0].style.transform = '';
      lineas[1].style.opacity   = '1';
      lineas[2].style.transform = '';
    } else {
      menuMovil?.classList.remove('hidden');
      menuMovil?.classList.add('flex');
      lineas[0].style.transform = 'translateY(8px) rotate(45deg)';
      lineas[1].style.opacity   = '0';
      lineas[2].style.transform = 'translateY(-8px) rotate(-45deg)';
    }
  });

  const header = document.getElementById('header-principal');
  const actualizarHeader = () => {
    if (window.scrollY > 10) {
      header?.classList.remove('bg-[var(--color-primary)]/80', 'backdrop-blur-md');
      header?.classList.add('bg-[var(--color-primary)]', 'shadow-lg');
    } else {
      header?.classList.add('bg-[var(--color-primary)]/80', 'backdrop-blur-md');
      header?.classList.remove('bg-[var(--color-primary)]', 'shadow-lg');
    }
  };
  window.addEventListener('scroll', actualizarHeader, { passive: true });
  actualizarHeader();

  // ── Dropdown selector de idioma ─────────────────────────────────────
  const btnLang   = document.getElementById('btn-lang');
  const dropdown  = document.getElementById('lang-dropdown');
  btnLang?.addEventListener('click', (e) => {
    e.stopPropagation();
    const abierto = btnLang.getAttribute('aria-expanded') === 'true';
    btnLang.setAttribute('aria-expanded', String(!abierto));
    dropdown?.classList.toggle('hidden', abierto);
  });
  document.addEventListener('click', () => {
    btnLang?.setAttribute('aria-expanded', 'false');
    dropdown?.classList.add('hidden');
  });
</script>
