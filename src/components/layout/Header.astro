---
/**
 * Header — Cabecera principal de Nourd Rent Car.
 * Sticky con fondo semitransparente que se vuelve sólido al hacer scroll.
 * Incluye menú hamburguesa funcional para móvil (sin framework JS).
 */
const enlaces = [
  { href: '/',          etiqueta: 'Inicio'   },
  { href: '/catalogo',  etiqueta: 'Catálogo' },
  { href: '/contacto',  etiqueta: 'Contacto' },
];

const rutaActual = Astro.url.pathname;
---

<header
  id="header-principal"
  class="sticky top-0 z-40 w-full transition-all duration-300
         bg-[var(--color-primary)]/80 backdrop-blur-md border-b border-white/5"
>
  <div class="section-container flex items-center justify-between h-16 md:h-20">

    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 shrink-0" aria-label="Nourd Rent Car Casablanca — Inicio">
      <img src="/logo.svg" alt="Nourd Rent Car Casablanca" class="h-12 w-auto" />
    </a>

    <!-- Navegación escritorio -->
    <nav aria-label="Navegación principal" class="hidden md:flex items-center gap-8">
      {enlaces.map(({ href, etiqueta }) => (
        <a
          href={href}
          class={`text-sm font-medium tracking-wide transition-colors duration-200
                  hover:text-[var(--color-accent)]
                  ${rutaActual === href
                    ? 'text-[var(--color-accent)]'
                    : 'text-[var(--color-text-base)]'}`}
          aria-current={rutaActual === href ? 'page' : undefined}
        >
          {etiqueta}
        </a>
      ))}
    </nav>

    <!-- Botón hamburguesa (móvil) -->
    <button
      id="btn-menu"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
      aria-controls="menu-movil"
      class="md:hidden flex flex-col justify-center items-center w-10 h-10 gap-1.5
             rounded-lg hover:bg-white/10 transition-colors duration-200"
    >
      <span class="hamburger-line block w-6 h-0.5 bg-white transition-all duration-300"></span>
      <span class="hamburger-line block w-6 h-0.5 bg-white transition-all duration-300"></span>
      <span class="hamburger-line block w-6 h-0.5 bg-white transition-all duration-300"></span>
    </button>
  </div>

  <!-- Menú móvil desplegable -->
  <nav
    id="menu-movil"
    aria-label="Menú móvil"
    class="md:hidden hidden flex-col border-t border-white/10
           bg-[var(--color-primary-light)]"
  >
    {enlaces.map(({ href, etiqueta }) => (
      <a
        href={href}
        class={`px-6 py-4 text-base font-medium border-b border-white/5
                transition-colors duration-200 hover:bg-white/5
                hover:text-[var(--color-accent)]
                ${rutaActual === href
                  ? 'text-[var(--color-accent)]'
                  : 'text-[var(--color-text-base)]'}`}
        aria-current={rutaActual === href ? 'page' : undefined}
      >
        {etiqueta}
      </a>
    ))}
  </nav>
</header>

<script>
  // ── Menú hamburguesa ────────────────────────────────────────────────
  const btnMenu   = document.getElementById('btn-menu');
  const menuMovil = document.getElementById('menu-movil');
  const lineas    = document.querySelectorAll<HTMLElement>('.hamburger-line');

  btnMenu?.addEventListener('click', () => {
    const abierto = btnMenu.getAttribute('aria-expanded') === 'true';
    btnMenu.setAttribute('aria-expanded', String(!abierto));

    if (abierto) {
      menuMovil?.classList.add('hidden');
      menuMovil?.classList.remove('flex');
      // Restaurar líneas
      lineas[0].style.transform = '';
      lineas[1].style.opacity   = '1';
      lineas[2].style.transform = '';
    } else {
      menuMovil?.classList.remove('hidden');
      menuMovil?.classList.add('flex');
      // Animar a X
      lineas[0].style.transform = 'translateY(8px) rotate(45deg)';
      lineas[1].style.opacity   = '0';
      lineas[2].style.transform = 'translateY(-8px) rotate(-45deg)';
    }
  });

  // ── Header sólido al hacer scroll ──────────────────────────────────
  const header = document.getElementById('header-principal');

  const actualizarHeader = () => {
    if (window.scrollY > 10) {
      header?.classList.remove('bg-[var(--color-primary)]/80', 'backdrop-blur-md');
      header?.classList.add('bg-[var(--color-primary)]', 'shadow-lg');
    } else {
      header?.classList.add('bg-[var(--color-primary)]/80', 'backdrop-blur-md');
      header?.classList.remove('bg-[var(--color-primary)]', 'shadow-lg');
    }
  };

  window.addEventListener('scroll', actualizarHeader, { passive: true });
  actualizarHeader();
</script>
