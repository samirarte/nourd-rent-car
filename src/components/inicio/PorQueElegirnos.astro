---

<section class="py-20 bg-[var(--color-primary-light)]" aria-labelledby="titulo-ventajas">
  <div class="section-container">

    <!-- Encabezado -->
    <div class="text-center mb-14">
      <p class="text-[var(--color-accent)] text-sm font-semibold uppercase tracking-widest mb-3">
        ¿Por qué elegirnos?
      </p>
      <h2 id="titulo-ventajas" class="font-heading text-3xl md:text-4xl font-bold text-white mb-4">
        El servicio que te mereces
      </h2>
      <p class="text-[var(--color-text-muted)] max-w-xl mx-auto">
        En Nourd Rent Car ponemos al cliente en el centro de todo lo que hacemos.
      </p>
    </div>

    <!-- Grid de ventajas -->
    <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8"
        aria-label="Ventajas del servicio">
      {ventajas.map(({ icono, titulo, descripcion }) => (
        <li class="flex gap-4 p-6 rounded-xl bg-[var(--color-primary)] border border-white/5
                   hover:border-[var(--color-accent)]/30 transition-colors duration-300">
          <!-- Icono -->
          <div class="shrink-0 w-12 h-12 flex items-center justify-center rounded-lg
                      bg-[var(--color-accent)]/10 text-[var(--color-accent)]"
               aria-hidden="true"
               set:html={icono}
          />
          <!-- Texto -->
          <div>
            <h3 class="font-semibold text-white mb-2">{titulo}</h3>
            <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">{descripcion}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
