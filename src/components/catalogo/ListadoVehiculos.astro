---
/**
 * ListadoVehiculos — Grid responsive de tarjetas de vehículos.
 */
import type { Vehiculo } from '../../types/vehiculo';
import TarjetaVehiculo from './TarjetaVehiculo.astro';

interface Props {
  vehiculos: Vehiculo[];
  categoriaActiva?: string;
}

const { vehiculos, categoriaActiva } = Astro.props;
---

{vehiculos.length === 0 ? (
  <div class="text-center py-20">
    <p class="text-[var(--color-text-muted)] text-lg">
      No hay vehículos disponibles
      {categoriaActiva && categoriaActiva !== 'Todos'
        ? ` en la categoría "${categoriaActiva}".`
        : '.'}
    </p>
    <a href="/catalogo" class="mt-4 inline-block text-[var(--color-accent)] hover:underline text-sm">
      Ver todos los vehículos
    </a>
  </div>
) : (
  <ul
    class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"
    aria-label="Listado de vehículos disponibles"
  >
    {vehiculos.map((vehiculo) => (
      <li>
        <TarjetaVehiculo vehiculo={vehiculo} />
      </li>
    ))}
  </ul>
)}
