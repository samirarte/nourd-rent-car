---
/**
 * Layout base de Nourd Rent Car.
 * Todas las páginas deben usar este layout para garantizar
 * metaetiquetas SEO coherentes y estilos globales.
 */
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import BotonWhatsApp from '../components/ui/BotonWhatsApp.astro';

interface Props {
  /** Título de la página (se añade "— Nourd Rent Car" automáticamente) */
  titulo: string;
  /** Descripción para <meta name="description"> y Open Graph */
  descripcion: string;
  /** URL de imagen para Open Graph (opcional) */
  imagen?: string;
  /** URL canónica de la página (opcional) */
  url?: string;
}

const {
  titulo,
  descripcion,
  imagen = '/og-default.jpg',
  url = Astro.url.href,
} = Astro.props;

const tituloCompleto = `${titulo} — Nourd Rent Car`;
const numeroWhatsApp = import.meta.env.PUBLIC_WHATSAPP_NUMBER ?? '34600000000';
const mensajeGeneral = encodeURIComponent('Hola, me gustaría obtener más información sobre vuestros servicios de alquiler.');
const enlaceWhatsApp = `https://wa.me/${numeroWhatsApp}?text=${mensajeGeneral}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- SEO principal -->
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={url} />

    <!-- Open Graph / redes sociales -->
    <meta property="og:type"        content="website" />
    <meta property="og:title"       content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:image"       content={imagen} />
    <meta property="og:url"         content={url} />
    <meta property="og:locale"      content="es_ES" />
    <meta property="og:site_name"   content="Nourd Rent Car" />

    <!-- Twitter Card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={tituloCompleto} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image"       content={imagen} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon"  href="/favicon.ico" />
  </head>

  <body class="min-h-screen flex flex-col">
    <Header />

    <main class="flex-1">
      <slot />
    </main>

    <Footer />

    <!-- Botón flotante de WhatsApp (visible en todas las páginas) -->
    <BotonWhatsApp
      href={enlaceWhatsApp}
      texto="WhatsApp"
      variante="flotante"
    />
  </body>
</html>
