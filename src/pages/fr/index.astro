---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroSeccion from '../../components/inicio/HeroSeccion.astro';
import VehiculosDestacados from '../../components/inicio/VehiculosDestacados.astro';
import PorQueElegirnos from '../../components/inicio/PorQueElegirnos.astro';
import { obtenerVehiculosDestacados } from '../../lib/vehiculos';
const lang = 'fr' as const;
const v = await obtenerVehiculosDestacados();
---
<BaseLayout lang={lang} titulo="Location de Véhicules Premium"
  descripcion="Nourd Rent Car — Location de véhicules de luxe avec et sans chauffeur à Casablanca, Maroc. SUV, Mercedes, Dacia et plus. Réservez directement via WhatsApp.">
  <HeroSeccion lang={lang} />
  <VehiculosDestacados vehiculos={v} lang={lang} />
  <PorQueElegirnos lang={lang} />
</BaseLayout>
