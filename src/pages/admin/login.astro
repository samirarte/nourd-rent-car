---
/**
 * Página de login del panel de administración — /admin/login
 */
export const prerender = false;

const error = Astro.url.searchParams.get('error');
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Acceso administración — Nourd Rent Car</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #1A1A2E;
      font-family: 'Inter', system-ui, sans-serif;
      padding: 1rem;
    }
    .card {
      background: #16213E;
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 1rem;
      padding: 2.5rem 2rem;
      width: 100%;
      max-width: 400px;
    }
    .logo { text-align: center; margin-bottom: 1.5rem; }
    .logo img { height: 48px; width: auto; }
    h1 {
      font-size: 1.25rem;
      font-weight: 600;
      color: #F5F5F5;
      text-align: center;
      margin-bottom: 0.25rem;
    }
    .subtitulo {
      font-size: 0.825rem;
      color: #9CA3AF;
      text-align: center;
      margin-bottom: 1.75rem;
    }
    label {
      display: block;
      font-size: 0.8rem;
      font-weight: 500;
      color: #9CA3AF;
      margin-bottom: 0.5rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    input[type="password"] {
      width: 100%;
      padding: 0.75rem 1rem;
      background: #1A1A2E;
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 0.5rem;
      color: #F5F5F5;
      font-size: 0.95rem;
      outline: none;
      transition: border-color 0.2s;
    }
    input[type="password"]:focus { border-color: #C9A84C; }
    .error {
      margin-top: 0.75rem;
      padding: 0.65rem 1rem;
      background: rgba(239,68,68,0.1);
      border: 1px solid rgba(239,68,68,0.3);
      border-radius: 0.5rem;
      color: #F87171;
      font-size: 0.825rem;
    }
    button {
      margin-top: 1.25rem;
      width: 100%;
      padding: 0.85rem;
      background: #C9A84C;
      color: #1A1A2E;
      font-weight: 700;
      font-size: 0.95rem;
      border: none;
      border-radius: 0.5rem;
      cursor: pointer;
      transition: background 0.2s, transform 0.1s;
    }
    button:hover { background: #B8973D; transform: translateY(-1px); }
    .volver {
      display: block;
      margin-top: 1.25rem;
      text-align: center;
      font-size: 0.8rem;
      color: #9CA3AF;
      text-decoration: none;
      transition: color 0.2s;
    }
    .volver:hover { color: #C9A84C; }
  </style>
</head>
<body>
  <div class="card">
    <div class="logo">
      <img src="/logo.svg" alt="Nourd Rent Car" />
    </div>
    <h1>Panel de administración</h1>
    <p class="subtitulo">Introduce la contraseña para continuar</p>

    <form method="POST" action="/api/admin/login">
      <label for="password">Contraseña</label>
      <input
        type="password"
        id="password"
        name="password"
        required
        autofocus
        autocomplete="current-password"
        placeholder="••••••••"
      />
      {error && (
        <p class="error" role="alert">Contraseña incorrecta. Inténtalo de nuevo.</p>
      )}
      <button type="submit">Acceder</button>
    </form>

    <a href="/" class="volver">← Volver al sitio</a>
  </div>
</body>
</html>
