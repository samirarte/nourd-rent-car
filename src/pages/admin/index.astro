---
/**
 * Panel de administración — /admin
 * Lista la flota completa con miniaturas y acciones rápidas.
 */
export const prerender = false;
import { obtenerTodosLosVehiculos } from '../../lib/vehiculos';
const vehiculos = await obtenerTodosLosVehiculos();
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Administration — Nourd Rent Car</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --bg:#1A1A2E; --bg2:#16213E; --accent:#C9A84C; --accentH:#B8973D;
      --text:#F5F5F5; --muted:#9CA3AF; --success:#25D366;
      --danger:#EF4444; --dangerH:#DC2626; --border:rgba(255,255,255,0.08); --r:.625rem;
    }
    body { background:var(--bg); color:var(--text); font-family:'Inter',system-ui,sans-serif; min-height:100vh; }
    a { color:inherit; text-decoration:none; }
    .topbar { position:sticky; top:0; z-index:40; display:flex; align-items:center;
              justify-content:space-between; padding:0 1.5rem; height:60px;
              background:var(--bg2); border-bottom:1px solid var(--border); }
    .topbar-logo { display:flex; align-items:center; gap:.75rem; }
    .topbar-logo img { height:36px; width:auto; }
    .topbar-logo span { font-size:.85rem; color:var(--muted); }
    .topbar-actions { display:flex; align-items:center; gap:.75rem; }
    .btn { display:inline-flex; align-items:center; gap:.4rem; padding:.5rem 1rem;
           border-radius:var(--r); border:none; cursor:pointer; font-size:.85rem;
           font-weight:600; transition:background .15s,transform .1s; }
    .btn:hover { transform:translateY(-1px); }
    .btn-primary { background:var(--accent); color:var(--bg); }
    .btn-primary:hover { background:var(--accentH); }
    .btn-ghost { background:transparent; color:var(--muted); border:1px solid var(--border); }
    .btn-ghost:hover { color:var(--text); border-color:rgba(255,255,255,.2); }
    .btn-danger { background:var(--danger); color:#fff; }
    .btn-danger:hover { background:var(--dangerH); }
    .btn-sm { padding:.35rem .75rem; font-size:.78rem; }
    .container { max-width:1400px; margin:0 auto; padding:1.5rem; }
    .stats { display:grid; grid-template-columns:repeat(auto-fit,minmax(140px,1fr)); gap:1rem; margin-bottom:1.5rem; }
    .stat { background:var(--bg2); border:1px solid var(--border); border-radius:var(--r); padding:1rem 1.25rem; }
    .stat-valor { font-size:1.75rem; font-weight:700; color:var(--accent); }
    .stat-label { font-size:.75rem; color:var(--muted); margin-top:.2rem; text-transform:uppercase; letter-spacing:.05em; }
    .tabla-wrap { overflow-x:auto; background:var(--bg2); border:1px solid var(--border); border-radius:var(--r); }
    table { width:100%; border-collapse:collapse; font-size:.85rem; }
    th { padding:.75rem 1rem; text-align:left; color:var(--muted); font-size:.72rem;
         text-transform:uppercase; letter-spacing:.06em; border-bottom:1px solid var(--border); white-space:nowrap; }
    td { padding:.65rem 1rem; border-bottom:1px solid var(--border); vertical-align:middle; }
    tr:last-child td { border-bottom:none; }
    tr:hover td { background:rgba(255,255,255,.02); }
    .badge { display:inline-block; padding:.15rem .6rem; border-radius:999px;
             font-size:.7rem; font-weight:700; text-transform:uppercase; letter-spacing:.05em; }
    .badge-si  { background:rgba(37,211,102,.15); color:var(--success); }
    .badge-no  { background:rgba(239,68,68,.15); color:var(--danger); }
    .badge-cat { background:rgba(201,168,76,.15); color:var(--accent); }
    .acciones  { display:flex; gap:.4rem; flex-wrap:nowrap; }
    .thumb { width:52px; height:36px; object-fit:cover; border-radius:.3rem;
             background:var(--bg); border:1px solid var(--border); }
    /* Modal eliminar */
    .overlay { display:none; position:fixed; inset:0; background:rgba(0,0,0,.75);
               z-index:100; align-items:center; justify-content:center; padding:1rem; }
    .overlay.open { display:flex; }
    .modal-box { background:var(--bg2); border:1px solid var(--border); border-radius:1rem;
                 max-width:420px; width:100%; padding:2rem; text-align:center; }
  </style>
</head>
<body>
  <header class="topbar">
    <div class="topbar-logo">
      <img src="/logo.svg" alt="Nourd Rent Car" />
      <span>/ Admin</span>
    </div>
    <div class="topbar-actions">
      <a href="/" class="btn btn-ghost btn-sm" target="_blank">Voir le site ↗</a>
      <form method="POST" action="/api/admin/login?accion=logout" style="display:inline">
        <button type="submit" class="btn btn-ghost btn-sm">Déconnexion</button>
      </form>
    </div>
  </header>

  <main class="container">
    <!-- Stats -->
    <div class="stats">
      <div class="stat"><div class="stat-valor">{vehiculos.length}</div><div class="stat-label">Total véhicules</div></div>
      <div class="stat"><div class="stat-valor">{vehiculos.filter(v=>v.disponible).length}</div><div class="stat-label">Disponibles</div></div>
      <div class="stat"><div class="stat-valor">{vehiculos.filter(v=>v.destacado).length}</div><div class="stat-label">En vedette</div></div>
      <div class="stat"><div class="stat-valor">{[...new Set(vehiculos.map(v=>v.categoria))].length}</div><div class="stat-label">Catégories</div></div>
    </div>

    <!-- Cabecera + acción -->
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem;flex-wrap:wrap;gap:.75rem;">
      <h1 style="font-size:1.25rem;font-weight:700;">Flotte de véhicules</h1>
      <a href="/admin/vehiculo/nuevo" class="btn btn-primary">+ Ajouter un véhicule</a>
    </div>

    <!-- Tabla -->
    <div class="tabla-wrap">
      <table>
        <thead>
          <tr>
            <th>Photo</th>
            <th>ID</th>
            <th>Nom / Slug</th>
            <th>Catégorie</th>
            <th>Galerie</th>
            <th>Sans chauffeur</th>
            <th>Avec chauffeur</th>
            <th>Disponible</th>
            <th>En vedette</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {vehiculos.map((v) => (
            <tr>
              <td>
                <img
                  src={v.imagenPrincipal}
                  alt={v.nombre}
                  class="thumb"
                  onerror="this.src='/vehiculos/placeholder.jpg'"
                />
              </td>
              <td style="color:var(--muted);font-size:.78rem;">{v.id}</td>
              <td>
                <div style="font-weight:600">{v.nombre}</div>
                <div style="font-size:.72rem;color:var(--muted)">{v.slug}</div>
              </td>
              <td><span class="badge badge-cat">{v.categoria}</span></td>
              <td style="font-size:.78rem;color:var(--muted);text-align:center;">
                {v.imagenes.length + 1} photo{v.imagenes.length !== 0 ? 's' : ''}
              </td>
              <td>{v.precioSinConductor} €/día</td>
              <td>{v.precioConConductor} €/día</td>
              <td><span class={`badge ${v.disponible ? 'badge-si':'badge-no'}`}>{v.disponible ? 'Oui':'Non'}</span></td>
              <td><span class={`badge ${v.destacado ? 'badge-si':'badge-no'}`}>{v.destacado ? 'Oui':'Non'}</span></td>
              <td>
                <div class="acciones">
                  <a href={`/admin/vehiculo/${v.id}`} class="btn btn-ghost btn-sm">Modifier</a>
                  <button class="btn btn-danger btn-sm"
                          onclick={`pedirEliminar(${v.id},'${v.nombre.replace(/'/g,"\\'")}')`}>
                    Supprimer
                  </button>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </main>

  <!-- Modal confirmar eliminación -->
  <div id="modal-del" class="overlay" role="dialog" aria-modal="true" aria-labelledby="del-titulo">
    <div class="modal-box">
      <div style="font-size:2.5rem;margin-bottom:1rem;">⚠️</div>
      <h2 id="del-titulo" style="font-size:1.1rem;font-weight:700;margin-bottom:.5rem;">Supprimer ce véhicule ?</h2>
      <p id="del-msg" style="color:var(--muted);font-size:.875rem;margin-bottom:1.5rem;"></p>
      <div style="display:flex;gap:.75rem;justify-content:center;">
        <button onclick="cerrarDel()" class="btn btn-ghost">Annuler</button>
        <button id="del-ok" class="btn btn-danger">Oui, supprimer</button>
      </div>
    </div>
  </div>

  <script>
    let delId = null;

    function pedirEliminar(id, nombre) {
      delId = id;
      document.getElementById('del-msg').textContent =
        `Cette action supprimera définitivement "${nombre}" et ne peut pas être annulée.`;
      document.getElementById('modal-del').classList.add('open');
      document.body.style.overflow = 'hidden';
    }

    function cerrarDel() {
      document.getElementById('modal-del').classList.remove('open');
      document.body.style.overflow = '';
      delId = null;
    }

    document.getElementById('del-ok').addEventListener('click', async () => {
      if (!delId) return;
      const btn = document.getElementById('del-ok');
      btn.disabled = true; btn.textContent = 'Suppression…';
      try {
        const res  = await fetch(`/api/vehiculos/${delId}`, { method: 'DELETE' });
        const data = await res.json();
        if (!res.ok) { alert(data.error ?? 'Erreur lors de la suppression'); return; }
        cerrarDel();
        window.location.reload();
      } catch { alert('Erreur réseau.'); }
      finally { btn.disabled = false; btn.textContent = 'Oui, supprimer'; }
    });

    // Cerrar overlay al clic fuera
    document.getElementById('modal-del').addEventListener('click', (e) => {
      if (e.target === document.getElementById('modal-del')) cerrarDel();
    });
  </script>
</body>
</html>
