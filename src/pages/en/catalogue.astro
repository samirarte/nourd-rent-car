---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FiltroCategorias from '../../components/catalogo/FiltroCategorias.astro';
import ListadoVehiculos from '../../components/catalogo/ListadoVehiculos.astro';
import { obtenerVehiculos, obtenerCategorias } from '../../lib/vehiculos';
import { useTranslations } from '../../i18n/utils';
const lang = 'en' as const;
const t = useTranslations(lang);
const categoriaParam = Astro.url.searchParams.get('categoria') ?? 'All';
// Mapear "All" → sin filtro; cualquier otro valor → filtrar
const categoriaFiltro = categoriaParam === 'All' ? undefined : categoriaParam;
const categorias  = await obtenerCategorias();
const vehiculos   = await obtenerVehiculos(categoriaFiltro);
const tituloSEO   = categoriaFiltro ? `Vehicles — ${categoriaFiltro}` : 'Vehicle Catalogue';
const descSEO     = `Explore our rental fleet${categoriaFiltro ? ` — ${categoriaFiltro}` : ''}. With and without driver. Book directly via WhatsApp.`;
---
<BaseLayout lang={lang} titulo={tituloSEO} descripcion={descSEO}>
  <div class="section-container py-16">
    <div class="mb-10">
      <p class="text-[var(--color-accent)] text-sm font-semibold uppercase tracking-widest mb-2">{t('catalogue.fleet')}</p>
      <h1 class="font-heading text-3xl md:text-4xl font-bold text-white mb-6">
        {categoriaFiltro ? `${t('catalogue.title.prefix')} ${categoriaFiltro}` : t('catalogue.title')}
      </h1>
      <FiltroCategorias categorias={categorias} categoriaActiva={categoriaParam} lang={lang} />
    </div>
    <p class="text-[var(--color-text-muted)] text-sm mb-6" aria-live="polite">
      {vehiculos.length} {vehiculos.length !== 1 ? t('catalogue.results.pl') : t('catalogue.results')}
    </p>
    <ListadoVehiculos vehiculos={vehiculos} categoriaActiva={categoriaParam} lang={lang} />
  </div>
</BaseLayout>
